# ---------------------------------------------------------------------------
# Secrets — never commit these.
# docker-compose.yml reads OPENAI_API_KEY from the environment or a .env file.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
!**/src/**/*.key
secrets/
application-local.properties
application-local.yml

# ---------------------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------------------
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
# The Maven Wrapper must stay committed, or ./mvnw cannot bootstrap on a fresh clone.
# (This project uses distributionType=only-script, so there is no jar today.)
!.mvn/wrapper/*.jar
*.war
*.ear
*.class
# Surefire crash dumps land at the module root, outside target/
*.dump
*.dumpstream
hs_err_pid*.log
replay_pid*.log

# H2 files, in case a service is switched from in-memory to file storage
*.mv.db
*.trace.db
*.lock.db

# ---------------------------------------------------------------------------
# Angular / Node
# ---------------------------------------------------------------------------
node_modules/
dist/
.angular/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
coverage/
# Vitest / Karma output
test-results/
playwright-report/

# ---------------------------------------------------------------------------
# Python fraud detection
# ---------------------------------------------------------------------------
fraud-detection/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.joblib
*.pkl
# Generated dry-run data; never commit it as if it were the real dataset.
# The real bank_transactions CSV IS tracked on purpose, so RESULTS.md is reproducible.
fraud-detection/bank_transactions_SYNTHETIC.csv

